---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import cv from '../data/cv.json';

const caseStudies = (await getCollection('case-studies'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const quickLinks = [
  { href: '/about', label: 'About & CV', description: 'Experience, education and skills.' },
  { href: '/projects', label: 'Projects', description: 'Case studies of things I have built.' },
  { href: '/contact', label: 'Contact', description: 'Email, GitHub and LinkedIn.' },
];
---

<BaseLayout
  title="Shin Yin Ong"
  description="Personal website of Shin Yin Ong — engineering work, case studies and CV."
>
  <section class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center sm:gap-12">
    <div class="flex-1">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        {cv.name}
      </h1>
      <p class="mt-3 text-lg text-accent-700 dark:text-accent-300">{cv.tagline}</p>
      <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-400">{cv.summary}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/projects"
          class="rounded-md bg-accent-700 px-4 py-2 text-sm font-medium text-white transition hover:bg-accent-800"
        >
          View projects
        </a>
        <a
          href="/contact"
          class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          Get in touch
        </a>
      </div>
    </div>
    <img
      src="/images/profile-placeholder.svg"
      alt="Placeholder profile photo of Shin Yin Ong"
      width="180"
      height="180"
      class="h-32 w-32 rounded-full border border-slate-200 object-cover sm:h-44 sm:w-44 dark:border-slate-800"
    />
  </section>

  <section class="mt-14" aria-labelledby="quick-links-heading">
    <h2 id="quick-links-heading" class="sr-only">Quick links</h2>
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        quickLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block h-full rounded-xl border border-slate-200 p-4 transition hover:border-accent-400 dark:border-slate-800"
            >
              <span class="font-medium text-slate-900 dark:text-slate-100">{link.label}</span>
              <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">{link.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14" aria-labelledby="featured-heading">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="featured-heading" class="text-xl font-semibold text-slate-900 dark:text-slate-100">
        Featured case studies
      </h2>
      <a href="/projects" class="text-sm text-accent-700 underline dark:text-accent-300">All projects</a>
    </div>
    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        caseStudies.map((entry) => (
          <CaseStudyCard
            href={`/projects/${entry.id}`}
            title={entry.data.title}
            summary={entry.data.summary}
            thumbnail={entry.data.thumbnail}
            tools={entry.data.tools}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
